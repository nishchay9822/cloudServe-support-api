<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="cloudserve-arch" name="CloudServe Architecture">
    <mxGraphModel dx="1500" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="CloudServe Intelligent Support System: Architecture" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="620" height="30" as="geometry" />
        </mxCell>

        <!-- Channels -->
        <mxCell id="chgrp" value="Input channels" style="swimlane;startSize=24;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="70" width="150" height="230" as="geometry" />
        </mxCell>
        <mxCell id="ch1" value="email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="chgrp">
          <mxGeometry x="15" y="38" width="120" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ch2" value="chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="chgrp">
          <mxGeometry x="15" y="84" width="120" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ch3" value="docs_comment&lt;br&gt;(alias api_comments)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="chgrp">
          <mxGeometry x="15" y="130" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ch4" value="forum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="chgrp">
          <mxGeometry x="15" y="180" width="120" height="36" as="geometry" />
        </mxCell>

        <!-- Kill switch -->
        <mxCell id="ks" value="Kill switch on?&lt;br&gt;(env / file / API)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="190" y="145" width="120" height="90" as="geometry" />
        </mxCell>

        <!-- Pipeline -->
        <mxCell id="ing" value="&lt;b&gt;1 Ingest&lt;/b&gt;&lt;br&gt;normalize_ticket()&lt;br&gt;injection screen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cls" value="&lt;b&gt;2 Classify&lt;/b&gt;&lt;br&gt;kNN first (vote &amp;ge; 0.85)&lt;br&gt;LLM if unsure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="150" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ret" value="&lt;b&gt;3 Retrieve&lt;/b&gt;&lt;br&gt;Chroma search&lt;br&gt;min score 0.30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="150" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rou" value="&lt;b&gt;4 Route&lt;/b&gt;&lt;br&gt;deterministic code&lt;br&gt;safety, evidence,&lt;br&gt;confidence &amp;ge; 0.80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="150" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gen" value="&lt;b&gt;5 Generate&lt;/b&gt;&lt;br&gt;full top article&lt;br&gt;citations, NO_ANSWER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="970" y="150" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="grd" value="&lt;b&gt;6 Guardrails&lt;/b&gt;&lt;br&gt;PII, grounding, figures,&lt;br&gt;injection, tone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="150" width="130" height="80" as="geometry" />
        </mxCell>

        <!-- LLM -->
        <mxCell id="llm" value="LLM provider&lt;br&gt;OpenRouter / any OpenAI-compatible&lt;br&gt;(retries, circuit breaker, fail fast on 401/402)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="50" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- Outputs -->
        <mxCell id="esc" value="&lt;b&gt;Escalate to human&lt;/b&gt;&lt;br&gt;summary, sources, reason code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="970" y="330" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;Auto reply&lt;/b&gt;&lt;br&gt;grounded, cited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="330" width="130" height="60" as="geometry" />
        </mxCell>

        <!-- Stores -->
        <mxCell id="vec" value="Chroma&lt;br&gt;docs + dev_tickets_v3" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="500" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="db" value="SQLite&lt;br&gt;decision log" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="810" y="500" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="res" value="Resolution records&lt;br&gt;(FR-13, write-only today)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="970" y="500" width="130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="prom" value="Prometheus /metrics&lt;br&gt;(Grafana in Stage 6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1290" y="500" width="150" height="80" as="geometry" />
        </mxCell>

        <!-- API + harness -->
        <mxCell id="api" value="FastAPI&lt;br&gt;/process /decisions /health /metrics&lt;br&gt;/admin/kill-switch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="340" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="har" value="Evaluation harness&lt;br&gt;--input / --output, unattended&lt;br&gt;metrics, judge, human-review CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="430" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pl" value="process_ticket()  (src/pipeline.py)" style="text;html=1;fontSize=11;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="330" y="240" width="250" height="20" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="leg" value="Green: model or data step. Yellow: policy checks (code). Red: human path. Purple: storage and provider. Dashed: side effects." style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="260" y="620" width="620" height="30" as="geometry" />
        </mxCell>

        <!-- Edges: main flow -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="chgrp" target="ks"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="off" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ks" target="ing"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ing" target="cls"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="cls" target="ret"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ret" target="rou"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="auto_respond" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="rou" target="gen"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="gen" target="grd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="all pass" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="grd" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Edges: escalation paths -->
        <mxCell id="x1" value="blocked / NO_ANSWER" style="html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="grd" target="esc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x2" value="safety intent, no evidence, low confidence" style="html=1;endArrow=block;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="rou" target="esc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x3" value="on: all tickets to humans" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="ks" target="esc">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="360" /></Array></mxGeometry>
        </mxCell>

        <!-- Edges: LLM -->
        <mxCell id="l1" style="html=1;endArrow=block;dashed=1;startArrow=block;strokeColor=#9673a6;" edge="1" parent="1" source="cls" target="llm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l2" style="html=1;endArrow=block;dashed=1;startArrow=block;strokeColor=#9673a6;" edge="1" parent="1" source="gen" target="llm"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Edges: stores -->
        <mxCell id="s1" value="kNN neighbours" style="html=1;endArrow=block;startArrow=block;dashed=1;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="cls" target="vec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2" value="doc search" style="html=1;endArrow=block;startArrow=block;dashed=1;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="ret" target="vec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3" value="every decision logged" style="html=1;endArrow=block;dashed=1;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="rou" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s4" style="html=1;endArrow=block;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="esc" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s5" style="html=1;endArrow=block;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="out" target="res"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s6" value="counters, latency" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#666666;exitX=1;exitY=0.75;exitDx=0;exitDy=0;fontSize=10;" edge="1" parent="1" source="grd" target="prom">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1365" y="210" /></Array></mxGeometry>
        </mxCell>

        <!-- Edges: entry points -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="api" target="chgrp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="har" target="api"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
