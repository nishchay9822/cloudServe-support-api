        <mxCell id="p2_d1" value="Kill switch on?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="160" y="128" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="p2_e_d1" value="&lt;b&gt;Escalate to a human&lt;/b&gt;&lt;br&gt;reason code: kill_switch" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="148" width="310" height="50" as="geometry"/></mxCell>
