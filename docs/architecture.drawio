<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="p1" name="1 High-level architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1110" pageHeight="480" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p0_title" value="High-level architecture: six processing components over three cross-cutting concerns" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="760" height="26" as="geometry"/></mxCell>
        <mxCell id="p0_chan" value="&lt;b&gt;Input channels&lt;/b&gt;&lt;br&gt;email, chat,&lt;br&gt;docs_comment, forum" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="p0_esc" value="&lt;b&gt;Escalate to a human&lt;/b&gt;&lt;br&gt;summary, sources, reason code" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="50" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="p0_auto" value="&lt;b&gt;Auto reply&lt;/b&gt;&lt;br&gt;with citations" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#cfe8d5;strokeColor=#4c9a6a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="980" y="50" width="100" height="60" as="geometry"/></mxCell>
        <mxCell id="p0_ing" value="&lt;b&gt;1 INGEST&lt;/b&gt;&lt;br&gt;kill switch, normalise,&lt;br&gt;injection and security-&lt;br&gt;wording screen" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="p0_cls" value="&lt;b&gt;2 CLASSIFY&lt;/b&gt;&lt;br&gt;intent, urgency,&lt;br&gt;calibrated confidence&lt;br&gt;(nearest tickets, LLM&lt;br&gt;if unsure)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="200" y="160" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="p0_ret" value="&lt;b&gt;3 RETRIEVE&lt;/b&gt;&lt;br&gt;hybrid search&lt;br&gt;(dense + BM25) over&lt;br&gt;the 29 articles" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="160" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="p0_rou" value="&lt;b&gt;4 ROUTE&lt;/b&gt;&lt;br&gt;deterministic rules:&lt;br&gt;safety, confidence 0.85,&lt;br&gt;evidence" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="160" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="p0_gen" value="&lt;b&gt;5 GENERATE&lt;/b&gt;&lt;br&gt;draft from the full&lt;br&gt;top article, with&lt;br&gt;citations" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="740" y="160" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="p0_val" value="&lt;b&gt;6 VALIDATE&lt;/b&gt;&lt;br&gt;guardrails: PII,&lt;br&gt;grounding, figures,&lt;br&gt;injection, tone" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="160" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="p0_log" value="&lt;b&gt;AUDIT LOG&lt;/b&gt;&lt;br&gt;every decision recorded with its reasoning&lt;br&gt;(SQLite: decisions, alternatives, sources)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="p0_mon" value="&lt;b&gt;MONITORING&lt;/b&gt;&lt;br&gt;latency, volume, drift&lt;br&gt;(Prometheus, Grafana, alert rules)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="385" y="330" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="p0_fb" value="&lt;b&gt;FEEDBACK LOOP&lt;/b&gt;&lt;br&gt;human corrections return (POST /feedback)&lt;br&gt;and join the classifier&#x27;s neighbour index" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fde9d9;strokeColor=#e8660b;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="750" y="330" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="p0_foot" value="Dashed arrows: each step writes to the audit log and the metrics, and a human correction feeds the next classification." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="1060" height="30" as="geometry"/></mxCell>
        <mxCell id="p0_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1f2933;fontSize=11;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_ing" target="p0_cls"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1f2933;fontSize=11;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_cls" target="p0_ret"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1f2933;fontSize=11;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_ret" target="p0_rou"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1f2933;fontSize=11;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_rou" target="p0_gen"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1f2933;fontSize=11;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_gen" target="p0_val"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1f2933;fontSize=11;fontColor=#1f2933;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_chan" target="p0_ing"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0_e6" value="escalate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;fontColor=#b85450;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_rou" target="p0_esc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0_e7" value="NO_ANSWER" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;fontColor=#b85450;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_gen" target="p0_esc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0_e8" value="all pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#4c9a6a;fontSize=11;fontColor=#4c9a6a;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_val" target="p0_auto"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0_e9" value="blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#b85450;fontSize=11;fontColor=#b85450;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_val" target="p0_esc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="80"/></Array></mxGeometry></mxCell>
        <mxCell id="p0_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;fontSize=11;fontColor=#9673a6;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_cls" target="p0_log"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;fontSize=11;fontColor=#9673a6;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_rou" target="p0_mon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p0_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#e8660b;fontSize=11;fontColor=#e8660b;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0_val" target="p0_fb"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
