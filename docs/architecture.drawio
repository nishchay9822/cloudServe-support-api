  </diagram>
  <diagram id="p2" name="2 Low-level design">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1130" pageHeight="700" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p1_L1" value="APPLICATION LAYER" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fillColor=#f6f7f9;strokeColor=#b8c4d0;fontColor=#4a4a68;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1090" height="190" as="geometry"/></mxCell>
        <mxCell id="p1_L2" value="MODEL AND RETRIEVAL LAYER" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fillColor=#fdf3ea;strokeColor=#f0c9a8;fontColor=#4a4a68;" vertex="1" parent="1"><mxGeometry x="20" y="262" width="1090" height="190" as="geometry"/></mxCell>
        <mxCell id="p1_L3" value="PERSISTENCE AND OBSERVABILITY LAYER" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;fillColor=#f6f7f9;strokeColor=#b8c4d0;fontColor=#4a4a68;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1090" height="190" as="geometry"/></mxCell>
        <mxCell id="p1_title" value="Low-level component design: three layers" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="800" height="26" as="geometry"/></mxCell>
        <mxCell id="p1_fast" value="&lt;b&gt;FastAPI&lt;/b&gt;&lt;br&gt;POST /tickets, POST /feedback&lt;br&gt;GET /decisions, /health, /metrics&lt;br&gt;POST /admin/kill-switch" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="106" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_orch" value="&lt;b&gt;Orchestrator&lt;/b&gt;&lt;br&gt;LangGraph state machine&lt;br&gt;(src/pipeline.py)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="310" y="106" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_guard" value="&lt;b&gt;Guardrail step (validate)&lt;/b&gt;&lt;br&gt;PII, grounding, figures,&lt;br&gt;injection, tone: can block" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="106" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_fmt" value="&lt;b&gt;Response formatter&lt;/b&gt;&lt;br&gt;(src/formatter.py)&lt;br&gt;reply + citations, or&lt;br&gt;escalation packet" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="850" y="106" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_clf" value="&lt;b&gt;Classifier chain&lt;/b&gt;&lt;br&gt;nearest labelled tickets,&lt;br&gt;then few-shot LLM prompt&lt;br&gt;(PR-CL-01 v2.0)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="324" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_emb" value="&lt;b&gt;Embedding model&lt;/b&gt;&lt;br&gt;all-MiniLM-L6-v2&lt;br&gt;(local)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="310" y="324" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_chroma" value="&lt;b&gt;Chroma vector store&lt;/b&gt;&lt;br&gt;hybrid search: dense + BM25&lt;br&gt;articles + labelled tickets" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="324" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_genc" value="&lt;b&gt;Generator chain&lt;/b&gt;&lt;br&gt;with citations&lt;br&gt;(PR-GN-01 v3.0)&lt;br&gt;LLM via OpenRouter or any&lt;br&gt;OpenAI-compatible provider" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="850" y="324" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_db" value="&lt;b&gt;SQLite decision log&lt;/b&gt;&lt;br&gt;decisions, resolution records,&lt;br&gt;feedback (PostgreSQL&lt;br&gt;would be a drop-in change)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="542" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_prom" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;metrics and alert rules" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="310" y="542" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_graf" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;dashboards (9 panels)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580" y="542" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_ci" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;CI pipeline&lt;br&gt;(tests and harness)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="850" y="542" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="p1_foot" value="Solid arrows: data flow. Dashed: calls and logging between layers." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="676" width="1090" height="20" as="geometry"/></mxCell>
        <mxCell id="p1_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1f2933;fontSize=11;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_fast" target="p1_orch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1f2933;fontSize=11;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_orch" target="p1_guard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1f2933;fontSize=11;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_guard" target="p1_fmt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1f2933;fontSize=11;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_clf" target="p1_emb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1f2933;fontSize=11;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_emb" target="p1_chroma"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#1f2933;fontSize=11;fontColor=#1f2933;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_chroma" target="p1_genc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#8a97a6;fontSize=11;fontColor=#8a97a6;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_orch" target="p1_emb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e7" value="sources shown to the guardrails" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#8a97a6;fontSize=11;fontColor=#8a97a6;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_chroma" target="p1_guard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1_e8" value="every decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;fontSize=11;fontColor=#9673a6;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_clf" target="p1_db"><mxGeometry relative="1" as="geometry"/></mxCell>
