# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM provider (OpenAI-compatible) ---
OPENROUTER_API_KEY=your_key_here
# Optional: use another provider instead. Groq (free tier) tested working:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_key
# MODEL_NAME=qwen/qwen3.8-27b
# JUDGE_MODEL=openai/gpt-oss-120b
# (Check available ids for your key: GET {LLM_BASE_URL}/models. Llama ids returned 404 on our Groq account.)
# OpenRouter defaults:
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
# Independent judge model (must differ from MODEL_NAME family)
JUDGE_MODEL=openai/gpt-4o-mini
# Rate-limit handling: wait up to this long per 429 (longer means a daily cap, fail fast)
LLM_RATE_LIMIT_MAX_WAIT_S=60
# OpenRouter only: route to the fastest provider (set empty to disable)
LLM_PROVIDER_SORT=throughput
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# --- Retrieval / storage ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.30
# Hybrid search: 1 = dense + BM25 fused by reciprocal rank; BM25 weight relative to dense
RETRIEVAL_HYBRID=1
RETRIEVAL_BM25_WEIGHT=0.15
# Articles not reviewed within this many days are never quoted (0 = off)
DOC_MAX_AGE_DAYS=180

# --- Routing / classification ---
CONFIDENCE_THRESHOLD=0.85
# Vote weight of always-escalate topics among neighbours that forces escalation
SAFETY_PROXIMITY=0.10
KNN_K=7
KNN_TRUST=0.85

# --- Operations ---
LOG_LEVEL=INFO
# Set to 1 (or create storage/KILL_SWITCH) to force every ticket to escalate
KILL_SWITCH=0
# Token required by POST /admin/kill-switch
ADMIN_TOKEN=
