# Free-tier setup using Groq (no payment needed). Copy to .env:   cp .env.groq.example .env   then paste your key.
# Tested: 80 of 80 validation tickets processed, independent judge found 0 hallucinations. Free-tier rate limits make replies slower
# (p95 about 11 s against the 3 s target), which is a provider limit, not a defect.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_key_here
# Check the model ids your account can use:  GET https://api.groq.com/openai/v1/models  (Llama ids were not available on our account)
MODEL_NAME=qwen/qwen3.8-27b
# A different model family from the generator, so the hallucination check stays independent
JUDGE_MODEL=openai/gpt-oss-120b
# Space calls to stay inside the free per-minute allowance (adjust to your plan); 0 disables pacing
LLM_MAX_RPM=20
LLM_CACHE=1
CONFIDENCE_THRESHOLD=0.85
